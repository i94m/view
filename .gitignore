# ---- 密钥 / 本地配置（.env.example 是模板，需提交）----
.env
.env.*
!.env.example

# ---- 本机 compose 配置（模板是 docker-compose.yml.example，需提交）----
docker-compose.yml

# ---- 运行时状态 / 挂载源（含登录 token、任务数据，勿提交）----
.multica/
multica/
workspace/
opencode/
opencode-config/*
!opencode-config/skills/
opencode-data/
sites/
view_sql/

# 例外：镜像构建上下文里的 apache 站点配置（否则会被上面的 sites/ 规则忽略）
!docker/base/src/sites/
!docker/base/src/sites/**

# ---- 构建产物 / 日志 ----
*.log
.playwright-mcp/

# ---- 验证 / 临时产物 ----
pw-mcp-verify.png

# ---- OS / 编辑器 ----
.DS_Store
.idea/
.vscode/
