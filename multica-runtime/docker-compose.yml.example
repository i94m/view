# 复制为 docker-compose.yml 后使用：cp docker-compose.yml.example docker-compose.yml
# 先从仓库根目录启动 docker-compose.agentmemory.yml，创建 view-agentmemory 网络。
# 宿主挂载路径用 .env 中的 HOST_*_PATH 覆盖。
services:
  runtime:
    image: ghcr.io/i94m/view:php8.4-multica
    container_name: multica-runtime
    env_file: [.env]
    extra_hosts:
      - "git.ap.tkelevator.com:10.251.68.173"
    stdin_open: true
    tty: true
    working_dir: /opt/tk
    environment:
      AGENTMEMORY_URL: http://agentmemory:3111
      AGENTMEMORY_SECRET: ${AGENTMEMORY_SECRET:?请先在 .env 中设置 AGENTMEMORY_SECRET}
      AGENTMEMORY_FORCE_PROXY: "1"
      VIEW_CODE_PATH: /opt/tk
      AI_ASSET_PATH: /opt/ai_asset
      AIR_PLATFORM_PATH: /opt/air_platform
      VIEW_SQL_PATH: /opt/db_change_scripts
      AUTO_TESTING_PATH: /opt/auto_testing
    volumes:
      - ${HOST_VIEW_PATH:-/path/to/view}:/opt/tk
      - ${HOST_ASSET_PATH:-/path/to/asset}:/opt/ai_asset
      - ${HOST_AIR_PLATFORM_PATH:-/path/to/air_platform}:/opt/air_platform
      - ${HOST_VIEW_SQL_PATH:-/path/to/view_sql}:/opt/db_change_scripts
      - ${HOST_AUTO_TESTING_PATH:-/path/to/auto_testing}:/opt/auto_testing
      - ${HOST_SITE_CONFIG:-/path/to/config.php}:/opt/site-config.php:ro
      - ./.multica:/root/.multica
      - ./workspace:/root/multica_workspaces
      - ./opencode-config:/root/.config/opencode
      - ./opencode-data:/root/.local/share/opencode
    ports:
      - "8080:80"
    networks:
      - default
      - agentmemory
    restart: unless-stopped

networks:
  agentmemory:
    external: true
    name: view-agentmemory
