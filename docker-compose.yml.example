services:
  runtime:
    image: registry.cn-hangzhou.aliyuncs.com/tke-view/view:php8.4-multica-runtime
    container_name: multica-runtime
    env_file: [.env]
    extra_hosts:
      - "git.ap.tkelevator.com:10.251.68.173"
    working_dir: /workspace
    stdin_open: true
    tty: true
    environment:
      VIEW_CODE_PATH: /workspace
      AI_ASSET_PATH: /opt/ai_asset
      AIR_PLATFORM_PATH: /opt/air_platform
      VIEW_SQL_PATH: /opt/db_change_scripts
      AUTO_TESTING_PATH: /opt/auto_testing
    volumes:
      - /Users/wade/web/tke/view:/workspace
      - /Users/wade/web/tke/asset:/opt/ai_asset
      - /Users/wade/web/tke/air_platform:/opt/air_platform
      - /Users/wade/web/tke/view_sql:/opt/db_change_scripts
      - /Users/wade/web/tke/autotest/dev2:/opt/auto_testing
      - ./.multica:/root/.multica
      - ./workspace:/root/multica_workspaces
      - ./opencode-config:/root/.config/opencode
      - ./opencode-data:/root/.local/share/opencode
    ports:
      - "8080:80"
    networks:
      - multica_net
    restart: unless-stopped

networks:
  multica_net:
    driver: bridge
    ipam:
      config:
        - subnet: 172.16.10.0/24
